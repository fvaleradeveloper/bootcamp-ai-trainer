# Copia este archivo como `.env.local` (desarrollo) y define las mismas
# variables en Vercel: Project Settings -> Environment Variables.
# Nunca subas este archivo a git.

# Connection string pooled de Neon (panel Neon -> Connection Details).
# Apunta a la database DEDICADA `bootcamp` con el rol `bootcamp_app`
# (una database por proyecto, ver README.md). Nunca a `neondb` de otro proyecto.
DATABASE_URL="postgresql://bootcamp_app:PASSWORD@ep-xxxx-xxxx.pooler.sa-east-1.aws.neon.tech/bootcamp?sslmode=require"

# Secreto para firmar tokens de sesion (genera uno largo y aleatorio).
SESSION_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"

# Asistente IA (Groq, tier gratuito) -> console.groq.com
# SOLO va en Vercel y en .env.local. NUNCA en el frontend.
# El codigo acepta los dos nombres: GROQ_API_KEY o GROQ_API_TOKEN.
GROQ_API_KEY="gsk_..."
# Modelo (opcional). Por defecto: qwen/qwen3.8-27b
# Ojo: Groq APAGO llama-3.3-70b-versatile el 16/08/2026 en los tiers gratuito
# y developer. Medidos contra este curso, los openai/gpt-oss-* responden con los
# fences de markdown corruptos; qwen/qwen3.8-27b da la semantica correcta del
# event loop. Alternativas gratuitas: openai/gpt-oss-20b, qwen/qwen3.6-27b.
GROQ_MODEL="qwen/qwen3.8-27b"
# Consultas por minuto y por IP (opcional, por defecto 12)
CHAT_RATE_LIMIT="12"

# NOTA: las variables de OTRO proyecto (apu-saas: NEXTAUTH, R2,
# GEOMETRY, NEXT_PUBLIC_APP_URL, etc.) NO aplican a este repo
# (bootcamp-ai-trainer) y NO deben agregarse aqui ni en Vercel.
# Este proyecto solo necesita DATABASE_URL + SESSION_SECRET
# (ver README.md). Los valores reales van SOLO en:
#   - Vercel: Project Settings -> Environment Variables, y
#   - local: archivo `.env.local` (gitignored, nunca se sube).